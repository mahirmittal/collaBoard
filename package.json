{
  "name": "synctask",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["server", "client"],
  "scripts": {
    "install:clean": "set \"NPM_CONFIG_OFFLINE=false\"&& npm install --no-audit --no-fund",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:memory": "set \"USE_MEMORY_DB=true\"&& set \"CLIENT_URL=http://127.0.0.1:5173\"&& concurrently \"npm run start --workspace=server\" \"npm run dev --workspace=client -- --host 127.0.0.1\"",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
